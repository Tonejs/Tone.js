{
	"name": "tone",
	"version": "15.5.72",
	"description": "A Web Audio framework for making interactive music in the browser.",
	"type": "module",
	"main": "build/esm/index.js",
	"module": "build/esm/index.js",
	"types": "build/esm/index.d.ts",
	"unpkg": "build/Tone.js",
	"files": [
		"README.md",
		"LICENSE.md",
		"build",
		"docs",
		"Tone"
	],
	"scripts": {
		"build": "npm run remove && npm run ts:build && npm run webpack:build",
		"changelog": "node scripts/changelog.mjs",
		"docs:json": "typedoc --options \"./scripts/typedoc.json\" --json \"./docs/tone.json\"",
		"lint": "tsc --noEmit && tsc -p ./examples/ui && eslint ./Tone ./examples/ui",
		"lint:fix": "tsc --noEmit && tsc -p ./examples/ui && eslint ./Tone ./test ./examples/ui --fix",
		"pretty": "prettier ./Tone ./test ./examples/ui -w",
		"scratch": "webpack serve --env scratch=1 --mode=development --config ./scripts/webpack.config.cjs",
		"spellcheck": "cspell --config ./scripts/cspell.json ./Tone ./test/**/*.ts ./examples/**/*.html \"./examples/ui/**/*.ts\"",
		"test": "npm run test -w test",
		"test:examples": "npm run examples -w test",
		"test:html": "npm run html -w test",
		"test:integrations": "npm run integrations -w test",
		"test:readme": "npm run readme -w test",
		"test:watch": "npm run watch -w test",
		"ts:build": "tsc --project ./scripts/tsconfig.build.json",
		"remove": "node -e \"fs.rmSync('./build', { recursive: true, force: true })\"",
		"watch": "tsc --watch",
		"webpack:build": "webpack --env production=1 --config ./scripts/webpack.config.cjs",
		"write_version": "node scripts/write_version.cjs"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Tonejs/Tone.js.git"
	},
	"keywords": [
		"Web Audio",
		"Web Audio API",
		"Synthesis",
		"Playback",
		"Effect",
		"Instrument",
		"DSP",
		"Signal Processing",
		"Interactive Music"
	],
	"author": "Yotam Mann (https://yotammann.info/)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Tonejs/Tone.js/issues"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin-js": "^4.2.0",
		"@stylistic/eslint-plugin-ts": "^4.2.0",
		"conventional-commits-parser": "^7.1.0",
		"cspell": "^9.0.2",
		"eslint": "^9.25.1",
		"eslint-plugin-html": "^8.1.2",
		"eslint-plugin-jsdoc": "^50.6.11",
		"eslint-plugin-no-only-tests": "^3.4.0",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-unused-imports": "^4.1.4",
		"html-webpack-plugin": "^5.6.3",
		"prettier": "^3.2.5",
		"semver": "^5.7.1",
		"simple-git": "^4.0.2",
		"ts-loader": "^9.5.1",
		"typedoc": "^0.28.12",
		"typescript": "^5.4.5",
		"typescript-eslint": "^8.31.0",
		"webpack": "^5.91.0",
		"webpack-cli": "^5.1.4",
		"webpack-dev-server": "^5.2.0"
	},
	"dependencies": {
		"standardized-audio-context": "^25.3.70",
		"tslib": "^2.3.1"
	},
	"prettier": {
		"trailingComma": "es5",
		"tabWidth": 4,
		"semi": true,
		"useTabs": true,
		"singleQuote": false
	},
	"publishConfig": {
		"provenance": true
	},
	"workspaces": [
		"examples/ui",
		"test"
	]
}
