{
	"name": "tone",
	"version": "15.5.57",
	"description": "A Web Audio framework for making interactive music in the browser.",
	"type": "module",
	"main": "build/esm/Tone/index.js",
	"module": "build/esm/Tone/index.js",
	"types": "build/esm/Tone/index.d.ts",
	"unpkg": "build/Tone.js",
	"files": [
		"README.md",
		"LICENSE.md",
		"build",
		"docs",
		"Tone"
	],
	"scripts": {
		"build": "npm run remove && npm run build:worklets && npm run ts:build && npm run build:single-file",
		"build:single-file": "node scripts/build-single-file.mjs",
		"build:worklets": "node scripts/build-worklets.mjs",
		"changelog": "node scripts/changelog.mjs",
		"docs:json": "typedoc --options \"./scripts/typedoc.json\" --json \"./docs/tone.json\"",
		"lint": "tsc --noEmit && tsc --noEmit --project ./scripts/tsconfig.worklet.json && eslint ./Tone",
		"lint:fix": "tsc --noEmit && tsc --noEmit --project ./scripts/tsconfig.worklet.json && eslint ./Tone ./test --fix",
		"prepare": "npm run build:worklets",
		"pretty": "prettier ./Tone ./test -w",
		"scratch": "node scripts/scratch.mjs",
		"spellcheck": "cspell --config ./scripts/cspell.json ./Tone ./test/**/*.ts ./examples/**/*.html",
		"test": "tsc && npm run build:worklets && web-test-runner --config=./test/web-test-runner.config.js --coverage ${npm_config_group:+--group ${npm_config_group}}",
		"test:examples": "node ./test/scripts/test_examples.mjs",
		"test:html": "node ./test/scripts/test_html.mjs",
		"test:integrations": "zx ./test/scripts/test_integrations.mjs",
		"test:readme": "node ./test/scripts/test_readme.mjs",
		"test:watch": "tsc && npm run build:worklets && concurrently --raw \"tsc -w\" \"npm run watch:worklets\" \"web-test-runner --config=./test/web-test-runner.config.js --watch ${npm_config_group:+--group ${npm_config_group}}\"",
		"ts:build": "tsc --project ./scripts/tsconfig.build.json",
		"remove": "node -e \"fs.rmSync('./build', { recursive: true, force: true })\"",
		"watch": "concurrently --raw \"tsc --watch\" \"npm run watch:worklets\"",
		"watch:worklets": "node --watch-path=Tone --watch scripts/build-worklets.mjs",
		"write_version": "node scripts/write_version.cjs"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Tonejs/Tone.js.git"
	},
	"keywords": [
		"Web Audio",
		"Web Audio API",
		"Synthesis",
		"Playback",
		"Effect",
		"Instrument",
		"DSP",
		"Signal Processing",
		"Interactive Music"
	],
	"author": "Yotam Mann (https://yotammann.info/)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Tonejs/Tone.js/issues"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^26.0.3",
		"@stylistic/eslint-plugin-js": "^4.2.0",
		"@stylistic/eslint-plugin-ts": "^4.2.0",
		"@types/audioworklet": "^0.0.100",
		"@types/chai": "^4.3.0",
		"@types/chai-almost": "^1.0.3",
		"@types/mocha": "^5.2.6",
		"@types/node": "22.15.21",
		"@types/sinon": "^21.0.0",
		"@types/sinon-chai": "^4.0.0",
		"@types/ua-parser-js": "^0.7.36",
		"@web/dev-server-esbuild": "^2.0.0",
		"@web/dev-server-rollup": "^1.0.0",
		"@web/test-runner": "^1.0.0",
		"@web/test-runner-chrome": "^1.0.1",
		"array2d": "^0.0.5",
		"audiobuffer-to-wav": "^1.0.0",
		"chai": "^5.1.0",
		"chai-almost": "^1.0.1",
		"codecov": "^3.8.3",
		"concurrently": "^8.2.2",
		"conventional-commits-parser": "^7.1.0",
		"cspell": "^9.0.2",
		"esbuild": "^0.28.2",
		"eslint": "^9.25.1",
		"eslint-plugin-html": "^8.1.2",
		"eslint-plugin-jsdoc": "^50.6.11",
		"eslint-plugin-no-only-tests": "^3.4.0",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-unused-imports": "^4.1.4",
		"fft-windowing": "^0.1.4",
		"fourier-transform": "^1.1.2",
		"fs-fixture": "^2.7.1",
		"http-server": "^13.0.2",
		"jsdom": "^26.1.0",
		"marked": "^15.0.12",
		"mocha": "^12.0.1",
		"plotly.js-dist": "^2.32.0",
		"prettier": "^3.2.5",
		"puppeteer": "^25.12.0",
		"semver": "^5.7.1",
		"simple-git": "^4.0.2",
		"sinon": "^21.0.0",
		"sinon-chai": "^4.0.1",
		"teoria": "^2.5.0",
		"tinyglobby": "^0.2.14",
		"tonal": "^6.0.1",
		"typedoc": "^0.28.12",
		"typescript": "5.4.5",
		"typescript-eslint": "^8.31.0",
		"ua-parser-js": "^0.7.31",
		"yargs": "^17.3.0",
		"zx": "^8.0.2"
	},
	"dependencies": {
		"standardized-audio-context": "^25.3.70",
		"tslib": "^2.3.1"
	},
	"prettier": {
		"trailingComma": "es5",
		"tabWidth": 4,
		"semi": true,
		"useTabs": true,
		"singleQuote": false
	},
	"publishConfig": {
		"provenance": true
	}
}
